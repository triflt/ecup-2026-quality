{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exp622_candidate_bank_schema_v1",
  "title": "Private exact-span candidate-bank row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "row_id",
    "semantic_component",
    "outer_fold",
    "role",
    "category",
    "supports_prediction",
    "source",
    "raw_start",
    "raw_end",
    "surface_start",
    "surface_end",
    "exact_surface_span",
    "span_sha256",
    "concept",
    "polarity",
    "scope",
    "extractor_vocabulary_version"
  ],
  "properties": {
    "schema_version": {"const": "exp622_candidate_bank_row_v1"},
    "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_id": {"type": "string", "minLength": 1},
    "semantic_component": {"type": "string", "minLength": 1},
    "outer_fold": {"enum": [0, 3]},
    "role": {"enum": ["outer_train", "outer_validation"]},
    "category": {"enum": ["БАД", "Легковоспламеняющиеся"]},
    "supports_prediction": {"enum": [0, 1]},
    "source": {"enum": ["name", "description"]},
    "raw_start": {"type": "integer", "minimum": 0},
    "raw_end": {"type": "integer", "minimum": 1},
    "surface_start": {"type": "integer", "minimum": 0},
    "surface_end": {"type": "integer", "minimum": 1},
    "exact_surface_span": {"type": "string", "minLength": 8, "maxLength": 160},
    "span_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "concept": {"type": "string"},
    "polarity": {"enum": ["asserted", "negated", "conditional"]},
    "scope": {"enum": ["product", "included", "excluded", "empty", "compatibility", "integrated_component"]},
    "extractor_vocabulary_version": {"const": "policy_concepts_v1"}
  }
}
