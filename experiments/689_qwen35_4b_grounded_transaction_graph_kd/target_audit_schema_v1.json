{
  "$defs": {
    "evidence_candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "candidate_index": {"minimum": 0, "type": "integer"},
        "char_end": {"minimum": 1, "type": ["integer", "null"]},
        "char_start": {"minimum": 0, "type": ["integer", "null"]},
        "evidence_kind": {"enum": ["text_span", "image_region"], "type": "string"},
        "evidence_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "image_region": {"enum": ["full", "q00", "q01", "q10", "q11", null]},
        "source_index": {"minimum": 0, "type": ["integer", "null"]}
      },
      "required": [
        "candidate_id",
        "candidate_index",
        "evidence_kind",
        "source_index",
        "char_start",
        "char_end",
        "image_region",
        "evidence_sha256"
      ],
      "type": "object"
    },
    "first_image": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "decoded_rgb_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "height": {"minimum": 2, "type": "integer"},
        "media_type": {"enum": ["image/jpeg", "image/png", "image/webp"]},
        "reference": {"minLength": 1, "type": "string"},
        "width": {"minimum": 2, "type": "integer"}
      },
      "required": [
        "reference",
        "content_sha256",
        "decoded_rgb_sha256",
        "media_type",
        "width",
        "height"
      ],
      "type": "object"
    },
    "review": {
      "additionalProperties": false,
      "properties": {
        "contradiction": {"type": "boolean"},
        "evidence_slice": {
          "enum": ["text_sufficient", "image_helpful", "image_required"]
        },
        "evidence_supported": {"type": "boolean"},
        "relation_correct": {"type": "boolean"},
        "sold_object_correct": {"type": "boolean"},
        "substance_correct": {"type": "boolean"},
        "unsupported_visual_claim": {"type": "boolean"}
      },
      "required": [
        "sold_object_correct",
        "substance_correct",
        "relation_correct",
        "evidence_supported",
        "unsupported_visual_claim",
        "contradiction",
        "evidence_slice"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "source_index": {"minimum": 0, "type": "integer"},
        "source_kind": {"enum": ["name", "description", "ocr"], "type": "string"},
        "text": {"minLength": 1, "type": "string"},
        "text_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["source_index", "source_kind", "text", "text_sha256"],
      "type": "object"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "object_evidence_candidate_ids": {
          "items": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "type": "array",
          "uniqueItems": true
        },
        "relation": {
          "enum": [
            "primary_sold_object",
            "included",
            "compatible_external",
            "mentioned_only",
            "negated",
            "absent",
            "unknown"
          ],
          "type": "string"
        },
        "relation_evidence_candidate_ids": {
          "items": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "type": "array",
          "uniqueItems": true
        },
        "sold_object": {
          "enum": ["device", "fuel_consumable", "accessory", "kit", "other", "unknown"],
          "type": "string"
        },
        "substance": {
          "enum": [
            "gas",
            "flammable_liquid",
            "solid_fuel",
            "ignition_aid",
            "none",
            "unknown"
          ],
          "type": "string"
        },
        "substance_evidence_candidate_ids": {
          "items": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "type": "array",
          "uniqueItems": true
        },
        "supervise": {"type": "boolean"},
        "support_status": {
          "enum": ["supported", "unsupported", "ambiguous"],
          "type": "string"
        }
      },
      "required": [
        "sold_object",
        "substance",
        "relation",
        "object_evidence_candidate_ids",
        "substance_evidence_candidate_ids",
        "relation_evidence_candidate_ids",
        "support_status",
        "supervise"
      ],
      "type": "object"
    }
  },
  "$id": "exp689_target_audit_row_v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_id": {"pattern": "^G689-[0-9]{3}$", "type": "string"},
    "evidence_candidates": {
      "items": {"$ref": "#/$defs/evidence_candidate"},
      "minItems": 5,
      "type": "array"
    },
    "first_image": {"$ref": "#/$defs/first_image"},
    "record_id": {"minLength": 1, "type": "string"},
    "request_row_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": "exp689_target_audit_row_v2"},
    "source_card_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "sources": {"items": {"$ref": "#/$defs/source"}, "minItems": 1, "type": "array"},
    "stratum": {
      "enum": [
        "direct_included_fuel",
        "device_accessory_compatible_mention",
        "singleton_new_family_ambiguous"
      ],
      "type": "string"
    },
    "target": {"$ref": "#/$defs/target"}
  },
  "required": [
    "schema_version",
    "audit_id",
    "record_id",
    "stratum",
    "source_card_sha256",
    "request_row_sha256",
    "sources",
    "first_image",
    "evidence_candidates",
    "target"
  ],
  "title": "Experiment 689 image-aware grounded transaction-graph target-audit row",
  "type": "object"
}
