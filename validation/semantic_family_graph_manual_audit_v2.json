  "required_fail_closed_policy_changes": [
    {
      "rule_id": "FC-V2-01",
      "rule": "Normalize Russian genericity by lemma or conservative stems before identity scoring; inflected weight-loss and product-class words must remain non-informative."
    },
    {
      "rule_id": "FC-V2-02",
      "rule": "Weight-loss marketing phrases and auxiliary creatives can never establish identity alone; require an exact independent brand-model or ingredient-dose anchor."
    },
    {
      "rule_id": "FC-V2-03",
      "rule": "For exact auxiliary or exact text edges with incompatible informative first images, require a strong independent identity anchor or quarantine the edge."
    },
    {
      "rule_id": "FC-V2-04",
      "rule": "Copied marketing content is non-independent evidence even when its key is rare in the current corpus."
    },
    {
      "rule_id": "FC-V2-05",
      "rule": "Before component closure, require pairwise strong-anchor consistency; generic names or descriptions must not bridge distinct image or brand clusters."
    },
    {
      "rule_id": "FC-V2-06",
      "rule": "For commodity product classes, quantity, function and generic appearance are insufficient; require a shared brand-model identifier or an exact informative primary image."
    },
    {
      "rule_id": "FC-V2-07",
      "rule": "After every merge, veto and quarantine any component containing incompatible informative first-image clusters without one shared strong identity anchor."
    }
